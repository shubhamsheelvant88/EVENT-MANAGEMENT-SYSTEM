<% layout("layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Login on Event management system</h1>
    <div class="col-6 offset-3">
        <form action="/login" method="POST">
       <div class="mb-3">
       <label for="username">Username</label>
            <input name="username" type="text" id="username">  <!-- // inside listing title in key value pair -->
       </div>

       <div class="mb-3">
       <label for="password">Password</label>
            <input name="password" type="password" id="password">  <!-- // inside listing title in key value pair -->
       </div>
       <button class="btn btn-success">Login</button>
    </form>
    </div>
</div>