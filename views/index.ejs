<% layout("layouts/boilerplate.ejs") %>


<h3>Events</h3>
<a href="/signup" >Sign up</a>
<a href="/login">Login</a>
<a href="/logout">Log out</a>
<!-- <form action="/events/new">
    <button>Create event</button>
</form> -->

<%if(currUser && currUser.role === "student") {%>
<form action="/my-events">
    <button>My events</button>
</form>
<%}%>
<%if(currUser && currUser.role === "student") {%>
<form action="/dashboard">
    <button>Dashboard</button>
</form>
<%}%>

<%for(event of events) {%>
    <ul>
        <li>Title : <%= event.title %></li>
        <li>Description : <%= event.description %></li>
        <li>Category : <%= event.category %></li>
        <li>Date : <%= event.date %></li>
        <li>Time : <%= event.time %></li>
        <li>Organiser : <%= event.organizer %></li>
        <li>Capacity : <%= event.capacity %></li>
        <li>Registration Deadline : <%= event.registrationDeadline %></li>
        <li>Status : <%= event.calculatedStatus %></li>
    </ul>
    <form action="/events/<%= event._id %>/show">
        <button>View Event</button>
    </form>
    <!-- <form action="/events/<%= event._id %>/edit">
        <button>Edit event</button>
    </form>
    <form action="/events/<%= event._id %>?_method=DELETE" method="POST">
        <button>Delete</button>
    </form> -->
    <hr>
<%}%>
