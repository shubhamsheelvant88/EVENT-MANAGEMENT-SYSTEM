<% layout("layouts/boilerplate.ejs") %>


<h3>Events</h3>
<a href="/signup" >Sign up</a>
<a href="/login">Login</a>
<a href="/logout">Log out</a>
<form action="/events/new">
    <button>Create event</button>
</form>

<%for(event of events) {%>
    <ul>
        <li><%= event.title %></li>
        <li><%= event.description %></li>
        <li><%= event.category %></li>
        <li><%= event.date %></li>
        <li><%= event.time %></li>
        <li><%= event.organizer %></li>
        <li><%= event.capacity %></li>
        <li><%= event.registrationDeadline %></li>
    </ul>
    <form action="/events/<%= event._id %>/show">
        <button>Show Event</button>
    </form>
    <form action="/events/<%= event._id %>/edit">
        <button>Edit event</button>
    </form>
    <form action="/events/<%= event._id %>?_method=DELETE" method="POST">
        <button>Delete</button>
    </form>

    <form action="/events/<%= event._id %>/register" method="POST">
        <button type="submit" >Register for an event</button>
    </form>
<%}%>
