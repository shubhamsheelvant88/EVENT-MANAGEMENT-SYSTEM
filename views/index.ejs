<% layout("layouts/boilerplate.ejs") %>

<h3>Events</h3>

<%for(event of events) {%>
    <ul>
        <li><%= event.title %></li>
        <li><%= event.description %></li>
        <li><%= event.category %></li>
        <li><%= event.date %></li>
        <li><%= event.time %></li>
        <li><%= event.organizer %></li>
        <li><%= event.capacity %></li>
        <li><%= event.registrationDeadline %></li>
    </ul>
<%}%>
