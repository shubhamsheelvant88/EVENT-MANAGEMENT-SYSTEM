<% layout("layouts/boilerplate.ejs") %>

<!-- <p><%= studentCount %></p>
<p><%= eventCount %></p>
<p><%= registrationCount %></p> -->


<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Total students</h5>
                
                <h2><%= studentCount %></h2>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Events</h5>
                
                <h2><%= eventCount %></h2>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Registered Students</h5>
                
                <h2><%= registrationCount %></h2>
            </div>
        </div>
    </div>
</div>

<form action="/admin/students">
    <button>Manage students</button>
</form>
<form action="/admin/events">
    <button>Manage Events</button>
</form>
<form action="/admin/registrations">
    <button>View participants</button>
</form>

<a href="/login">Login</a>

<form action="/logout">
    <button>Logout</button>
</form>

